.language-select-wrap
  position fixed
  left 0
  top 0
  width 100%
  height 100%
  z-index 9999
  background #fff
  display flex
  align-items center
  justify-content center

.language-select-card
  width 420px
  max-width 90vw
  padding 36px 28px
  text-align center

.language-select-icon
  font-size 48px
  color #08c

.language-select-title
  margin 16px 0 24px
  font-size 18px
  font-weight 600
  color #333

.language-select-list
  display flex
  flex-wrap wrap
  gap 10px
  justify-content center

.language-select-item
  min-width 120px
  padding 10px 16px
  font-size 14px
  color #333
  background #f5f5f5
  border 1px solid #e0e0e0
  border-radius 8px
  cursor pointer
  transition all 0.15s ease
  outline none

  &:hover
    color #fff
    background #08c
    border-color #08c
